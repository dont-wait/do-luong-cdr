generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model Department {
  department_id   String @id @default(cuid()) @db.Char(10)
  department_name String @db.VarChar(255)

  academics Academic[]
}

model Academic {
  academic_id    String @id @default(cuid()) @db.Char(10)
  academic_name  String @db.VarChar(50)
  academic_level Int
  academic_type  Int
  department_id  String @db.Char(10)

  department       Department         @relation(fields: [department_id], references: [department_id])
  academic_subject Academic_subject[]
  plo              Plo[]
  lecturer         Lecturer[]
  student          Student[]
}

model Academic_subject {
  academic_id String @default(cuid()) @db.Char(10)
  subject_id  String @db.Char(10)

  academic Academic @relation(fields: [academic_id], references: [academic_id])
  subject  Subject  @relation(fields: [subject_id], references: [subject_id])

  @@id([academic_id, subject_id])
}

model Lecturer {
  lecturer_id String @id @default(cuid()) @db.Char(12)
  first_name  String @db.VarChar(15)
  last_name   String @db.VarChar(50)
  email       String @unique @db.VarChar(255)
  phone       String @unique @db.Char(12)

  degree_id   String   @db.Char(10)
  degree      Degree   @relation(fields: [degree_id], references: [degree_id])
  academic_id String   @db.Char(10)
  academic    Academic @relation(fields: [academic_id], references: [academic_id])

  subjects Subject[]
  class    Class[]
}

model Plo {
  plo_id      Int    @id
  plo_name    String @db.Char(10)
  plo_content String @db.VarChar(255)

  academic_id String   @db.Char(10)
  academic    Academic @relation(fields: [academic_id], references: [academic_id])

  plo_detail Plo_detail[]
  plo_clo    Plo_clo[]
}

model Plo_clo {
  plo_id Int
  clo_id Int

  plo Plo @relation(fields: [plo_id], references: [plo_id])
  clo Clo @relation(fields: [clo_id], references: [clo_id])

  @@id([plo_id, clo_id])
}

model Plo_detail {
  plo_detail_id   String @id @default(cuid()) @db.Char(10)
  plo_detail_name String @db.Char(10)
  plo_content     String @db.VarChar(255)

  plo_id Int
  plo    Plo @relation(fields: [plo_id], references: [plo_id])
}

model Subject {
  subject_id          String  @id @default(cuid()) @db.Char(10)
  subject_name        String  @db.VarChar(255)
  practical_credits   Int
  theoretical_credits Int
  description         String? @db.VarChar(255)

  lecturer_id String   @db.Char(12)
  lecturer    Lecturer @relation(fields: [lecturer_id], references: [lecturer_id])

  academic_subject Academic_subject[]
  class            Class[]
  clo              Clo[]
}

model Clo {
  clo_id      Int    @id
  clo_name    String @db.Char(10)
  clo_content String @db.VarChar(255)
  target_id   String @db.VarChar(10)

  subject_id   String        @db.VarChar(10)
  subject      Subject       @relation(fields: [subject_id], references: [subject_id])
  exam_details Exam_detail[]
  Result       Result[]
  plo_clo      Plo_clo[]
}

model Exam_detail {
  clo_id  Int
  exam_id String @db.Char(10)

  exam Exam @relation(fields: [exam_id], references: [exam_id])
  clo  Clo  @relation(fields: [clo_id], references: [clo_id])

  @@id([exam_id, clo_id])
}

model Exam {
  exam_id   String   @id @default(cuid()) @db.Char(10)
  exam_name String   @db.VarChar(255)
  date      DateTime @default(now())

  class_id String @db.Char(10)
  class    Class  @relation(fields: [class_id], references: [class_id])

  exam_details Exam_detail[]
  Result       Result[]
}

model Class {
  class_id String @id @default(cuid()) @db.Char(10)

  subject_id String  @db.Char(10)
  subject    Subject @relation(fields: [subject_id], references: [subject_id])

  lecturer_id String   @db.Char(12)
  lecturer    Lecturer @relation(fields: [lecturer_id], references: [lecturer_id])

  exams Exam[]
}

model Role {
  role_id   Int    @id
  role_name String @db.VarChar(50)

  user_account User_account[]
}

model User_account {
  user_account_id String @id @default(cuid()) @db.Char(12)
  password        String @db.VarChar(255)

  role_id Int
  role    Role @relation(fields: [role_id], references: [role_id])
}

model Student {
  student_id String @id @default(cuid()) @db.Char(12)
  first_name String @db.VarChar(255)
  last_name  String @db.VarChar(255)
  email      String @unique @db.VarChar(255)
  phone      String @unique @db.Char(12)

  academic_id String   @db.Char(10)
  academic    Academic @relation(fields: [academic_id], references: [academic_id])

  Result Result[]
}

model Result {
  result_id String @id @default(cuid())
  score     Float

  student_id String @db.Char(12)
  exam_id    String @db.Char(10)
  clo_id     Int

  student Student @relation(fields: [student_id], references: [student_id])
  exam    Exam    @relation(fields: [exam_id], references: [exam_id])
  clo     Clo     @relation(fields: [clo_id], references: [clo_id])
}

model Degree {
  degree_id   String @id @default(cuid()) @db.Char(10)
  degree_name String @db.VarChar(255)

  leturer Lecturer[]
} 
