generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model Department {
  id   String @id
  department_name String @db.VarChar(255)

  academics Academic[]
}

model Academic {
  id    String @id
  academic_name  String @db.VarChar(50)
  academic_level Int
  academic_type  Int

  department_id String
  department    Department @relation(fields: [department_id], references: [id])

  academic_subject Academic_subject[]
  plo              Plo[]
  lecturer         Lecturer[]
  student          Student[]
}

model Academic_subject {
  academic_id String
  subject_id  String

  academic Academic @relation(fields: [academic_id], references: [id])
  subject  Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@id([academic_id, subject_id])
}

model Plo {
  id      String    @id @default(uuid())
  plo_name    String @db.Char(10)
  plo_content String @db.VarChar(255)

  academic_id String
  academic    Academic @relation(fields: [academic_id], references: [id])

  plo_detail Plo_detail[]
  plo_clo    Plo_clo[]
}

model Plo_clo {
  plo_id String
  clo_id String

  plo Plo @relation(fields: [plo_id], references: [id])
  clo Clo @relation(fields: [clo_id], references: [id])

  @@id([plo_id, clo_id])
}

model Plo_detail {
  id   String @id
  plo_detail_name String @db.Char(10)
  plo_content     String @db.VarChar(255)

  plo_id String
  plo    Plo @relation(fields: [plo_id], references: [id])
}

model Subject {
  id          String     @id 
  subject_name        String  @db.VarChar(255)
  practical_credits   Int 
  theoretical_credits Int
  description         String? @db.VarChar(255)

  lecturer_subject_manager_id String
  lecturer Lecturer @relation(fields: [lecturer_subject_manager_id], references: [id], onDelete: Cascade)

  academic_subject Academic_subject[]
  class            Class[]
  clo              Clo[]

  LecturerSubject LecturerSubject[]
  Approve         Approve[]

  @@unique([id, lecturer_subject_manager_id])
}

model LecturerSubject {
  lecturer_id String
  subject_id String

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id])
  subject  Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@id([lecturer_id, subject_id])
}

model Clo {
  id        String    @id @default(uuid())
  clo_name      String @db.Char(10)
  clo_content   String @db.VarChar(255)
  clo_parent_id String?

  subject_id String
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  plo_clo      Plo_clo[]
  Question Question[]
}


model Exam {
  id   String      @id @default(uuid())
  exam_name String   @db.VarChar(255)
  date_exam      DateTime? @default(now())

  class_id String
  class    Class  @relation(fields: [class_id], references: [id])
  questions Question[]
}

model Question {
  id String    @id @default(uuid())
  question_name    String @db.VarChar(255)
  max_score        Float

  exam_id String
  clo_id String 
  clo   Clo @relation(fields: [clo_id], references: [id])
  exam    Exam @relation(fields: [exam_id], references: [id])

  Result Result[]
}

model Result {
  id String   @id @default(uuid())
  score     Float?

  student_id String
  question_id String


  question Question @relation(fields: [question_id], references: [id])
  student Student @relation(fields: [student_id], references: [id])
}

model Class {
  id String @id

  subject_id String
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  lecturer_id String
  lecturer    Lecturer @relation(fields: [lecturer_id], references: [id])

  exams Exam[]

  ClassStudent ClassStudent[]
}
//This table for many student in many class
model ClassStudent {
  student_id String 
  class_id String 

  student Student @relation(fields: [student_id], references: [id])
  class   Class   @relation(fields: [class_id], references: [id])
  @@id([student_id, class_id])
}


model Role {
  id   Int    @id @unique
  role_name String @db.VarChar(50) @unique

  user_account User_account[]
}

model User_account {
  id String @id @default(uuid()) 
  password        String @db.VarChar(255)
  admin_id    String? @unique
  student_id  String? @unique
  lecturer_id String? @unique
  role_id Int

  role    Role @relation(fields: [role_id], references: [id])
  admin    Admin?   @relation(fields: [admin_id], references: [id])
  student  Student? @relation(fields: [student_id], references: [id])
  lecturer Lecturer? @relation(fields: [lecturer_id], references: [id])
}

model Lecturer {
  id String @id @unique
  first_name  String @db.VarChar(15)
  last_name   String @db.VarChar(50)
  email       String @unique @db.VarChar(255)
  phone       String @unique @db.Char(12)

  degree_id   Int
  degree      Degree   @relation(fields: [degree_id], references: [id])
  academic_id String
  academic    Academic @relation(fields: [academic_id], references: [id])

  subjects     Subject[]
  class        Class[]
  user_account User_account?

  LecturerSubject LecturerSubject[]
  sender         Approve[] @relation(name: "sender")
  receiver       Approve[] @relation(name: "receiver")
}

model Student {
  id String @id @unique
  first_name String @db.VarChar(255)
  last_name  String @db.VarChar(255)
  email      String @unique @db.VarChar(255)
  phone      String @unique @db.Char(12)

  academic_id String
  academic    Academic @relation(fields: [academic_id], references: [id])

  Result       Result[]
  user_account User_account?

  ClassStudent ClassStudent[]
}

model Admin {
  id   String @id @unique
  first_name String @db.VarChar(255)
  last_name  String @db.VarChar(255)
  email      String @unique @db.VarChar(255)
  phone      String @unique @db.Char(12)
  user_account User_account?
}


model Degree {
  id   Int    @id
  degree_name String @db.VarChar(255)

  leturer Lecturer[]
}

model Approve {
  id String @id @default(uuid())
  sender_id String
  receiver_id String
  subject_id String 
  data Json
  approve Boolean @default(false)
  approve_date DateTime? @default(now())

  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  receiver Lecturer @relation(fields: [receiver_id], references: [id], name: "receiver")
  sender Lecturer @relation(fields: [sender_id], references: [id], name: "sender")

  @@unique([subject_id, receiver_id, sender_id])
}